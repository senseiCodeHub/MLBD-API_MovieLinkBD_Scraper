# Copy to .env and fill in. .env is gitignored.

# Local SQLite library (created automatically; gitignored).
# MLBD_DB_PATH=data/library.db

# MySQL database (replace Supabase for scrape data storage).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mlbd

# How long a stored scrape is served when the live site is unreachable.
# MLBD_SCRAPE_CACHE_SECONDS=21600
