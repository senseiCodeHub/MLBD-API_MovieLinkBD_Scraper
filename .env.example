# Copy to .env and fill in. .env is gitignored.

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Required to write scraped titles/pages/links from the local scraper.
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only key; used when the service-role key is absent.
SUPABASE_ANON_KEY=

# How long a stored scrape is served when the live site is unreachable.
# MLBD_SCRAPE_CACHE_SECONDS=21600
